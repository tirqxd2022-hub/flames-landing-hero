NODE_ENV=production
# PORT only used for local dev; on cPanel Passenger injects its own socket.
# PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=gomeslen_flames_user
DB_PASSWORD=changeme
DB_NAME=gomeslen_flames_db

# Generate with: openssl rand -hex 48
JWT_SECRET=please-change-this-to-a-long-random-string

ADMIN_BOOTSTRAP_EMAIL=admin@flamesgourmet.ca
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

CORS_ORIGINS=https://new.flamesgourmet.ca,https://www.new.flamesgourmet.ca
PUBLIC_SITE_URL=https://new.flamesgourmet.ca

UPLOADS_DIR=/home/gomeslen/flames-api/uploads
PRODUCTS_DIR=/home/gomeslen/flames-api/products

# ---------------------------------------------------------------
# SMTP (cPanel native email) — used for newsletter, order emails,
# and contact form notifications. Leave SMTP_HOST blank to disable
# real sending (emails will only be logged to the server console).
#
# Typical cPanel values:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=465              (SSL)  or  587 (STARTTLS)
#   SMTP_USER=orders@yourdomain.com
#   SMTP_PASS=your-mailbox-password
#   SMTP_FROM="Flames Gourmet <orders@yourdomain.com>"
# Optional: address that receives contact-form / new-order notices.
#   SMTP_NOTIFY_TO=owner@yourdomain.com
# ---------------------------------------------------------------
SMTP_HOST=mail.flamesgourmet.ca
SMTP_PORT=465
SMTP_USER=info@flamesgourmet.ca
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM="Flames Gourmet <info@flamesgourmet.ca>"
SMTP_NOTIFY_TO=info@flamesgourmet.ca
